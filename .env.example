# Optional LLM extraction. Leave unset to use the deterministic heuristic scorer.
# Scoring always stays on the published rubric; the LLM may only propose structured fields.
DESKFLOW_LLM_API_KEY=
DESKFLOW_LLM_BASE_URL=https://api.openai.com/v1
DESKFLOW_LLM_MODEL=gpt-4o-mini
DESKFLOW_LLM_TIMEOUT_SECONDS=12

# App bind (Docker / App Runner use PORT=8080)
PORT=8080

# SQLite file (default). Same models work with Postgres:
# DESKFLOW_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/deskflow
DESKFLOW_DATABASE_URL=sqlite:///data/deskflow.sqlite

# dev | test | production. Sample-account shortcuts on My Tekforce only in dev and test.
DESKFLOW_ENV=dev
